pipeline { 
    agent any
    
    tools{
        maven 'Maven'
    }

    stages { 
        stage('Checkout')  { 
            steps { 
                checkout scm 
            } 
        }

    stage('Verify Maven') { 
        steps { 
            bat 'cd' 
            bat 'mvn --version' 
        } 
    }

    stage('Clean and Test') { 
        steps { 
            bat 'mvn clean test' 
        } 
    }

    stage('Package') {
        steps {
            bat 'mvn package' 
            } 
        } 
    }

    post { 
        always { 
            junit( 
                testResults: '/target/surefire-reports/TEST-*.xml', allowEmptyResults: true 
            ) 
        } 
    } 
}